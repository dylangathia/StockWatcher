# Copy this file to .env and fill in your key to enable AI insights.
# Get a Groq key at https://console.groq.com/keys
GROQ_API_KEY=gsk_...

# Optional
# GROQ_MODEL=openai/gpt-oss-120b      # or openai/gpt-oss-20b (cheaper, lighter analysis)
# GROQ_REASONING_EFFORT=medium        # low | medium | high (higher = deeper analysis, slower, more tokens)
# AI_WEB_SEARCH=1                     # 0 to stop the AI from searching recent news

# To use Claude instead of Groq:
# AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_EFFORT=medium
